{
  "name": "clipfarm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/worker.js && node --check src/account.js && node --check public/app.js && python3 -m unittest discover -s engine -p 'test_*.py'",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
